{
  "description": "Vendor integration connects built on RESTler and Guardian",
  "license": "MIT",
  "author": "TundraSoft",
  "homepage": "https://github.com/TundraSoft/tundra-connect",
  "repository": {
    "type": "git",
    "url": "https://github.com/TundraSoft/tundra-connect.git"
  },
  "unstable": [],
  "workspace": [
    "./connectors/*"
  ],
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "0",
  "imports": {
    "@asserts": "jsr:@std/assert@^1.0.19",
    "@test": "jsr:@tundralibs/compat@^2.7.4/test",
    "@restler": "jsr:@tundralibs/restler@^1.3.1",
    "@guardian": "jsr:@tundralibs/guardian@^1.3.3",
    "@crypt": "jsr:@tundralibs/crypt@^1.4.1",
    "@id": "jsr:@tundralibs/id@^1.1.4",
    "@encoding": "jsr:@std/encoding@^1.0.11"
  },
  "tasks": {
    "check": "deno task check:fmt && deno task check:lint && deno task check:types",
    "check:fmt": "deno fmt --check",
    "check:lint": "deno lint",
    "check:types": "deno check ./connectors/*/mod.ts",
    "test": "deno task test:run && deno task test:report",
    "test:run": "deno test --allow-read --allow-write --allow-env --allow-net --parallel --coverage=coverage --junit-path=./test-report.xml",
    "test:report": "deno coverage coverage --lcov --output=coverage/report.lcov",
    "publish:dry": "deno publish --dry-run",
    "workspace:add": "deno run --allow-read --allow-write --allow-run=deno .github/scripts/workspace.ts add",
    "workspace:remove": "deno run --allow-read --allow-write .github/scripts/workspace.ts remove",
    "workspace:sync": "deno run --allow-read --allow-write .github/scripts/workspace.ts sync",
    "workspace:sync:check": "deno run --allow-read .github/scripts/workspace.ts sync --check"
  },
  "compilerOptions": {
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "allowUnreachableCode": false,
    "noErrorTruncation": true
  },
  "lint": {
    "report": "pretty",
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      "./.vscode",
      "./.git",
      "./.github",
      "./.sonarlint",
      "./.devcontainer",
      "**/fixtures/**",
      "**/tests/**",
      "**/*.test.ts"
    ]
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "useTabs": false,
    "proseWrap": "preserve",
    "semiColons": true,
    "singleQuote": true,
    "exclude": [
      "./.vscode",
      "./.git",
      "./.github",
      "./.sonarlint",
      "./.devcontainer",
      "**/fixtures/**",
      "**/CHANGELOG.md"
    ]
  },
  "test": {
    "exclude": [
      "./.vscode",
      "./.git",
      "./.github",
      "./.devcontainer",
      "coverage",
      "docs",
      "**/fixtures/**"
    ]
  },
  "bench": {
    "exclude": [
      "./.vscode",
      "./.git",
      "./.github",
      "./.devcontainer",
      "coverage",
      "docs",
      "**/fixtures/**"
    ]
  },
  "lock": true
}
