# Env vars for live vendor testing — see CONVENTIONS.md's "Tests" section.
#
# Each connect's live-test block is skipped unless ALL of its listed vars
# are present, independently of every other connect — set only the ones you
# have real (or sandbox) credentials for. The same names become GitHub repo
# secrets so CI can do the same (see .github/workflows/live-tests.yml).
#
# LIVE_TEST_ALLOW_VISIBLE_EFFECTS additionally gates the handful of
# operations that have a real-world-visible side effect with no way to
# undo it (an actual chat message, SMS, or call) — never set this on the
# automatic monthly CI schedule, only locally or via a manual dispatch.

# CoinGecko — demo tier is keyless; set this only for a pro-tier key.
CONNECTOR_COINGECKO_API_KEY=your_coingecko_api_key_here

# OpenExchangeRates
CONNECTOR_OPENEXCHANGE_APP_ID=your_openexchange_app_id_here

# OpenWeatherMap
CONNECTOR_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Algolia — self-contained: creates/deletes its own throwaway test index.
CONNECTOR_ALGOLIA_APPLICATION_ID=your_algolia_application_id_here
CONNECTOR_ALGOLIA_API_KEY=your_algolia_api_key_here

# Upstash Redis — self-contained: sets/deletes its own throwaway test key.
CONNECTOR_UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here
CONNECTOR_UPSTASH_REDIS_BASE_URL=https://your-database.upstash.io

# S3 — TEST_BUCKET must already exist; the live test can't create one.
CONNECTOR_S3_ACCESS_KEY_ID=your_s3_access_key_id_here
CONNECTOR_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
CONNECTOR_S3_REGION=us-east-1
CONNECTOR_S3_TEST_BUCKET=your-test-bucket-name

# GCS — TEST_BUCKET must already exist; the live test can't create one.
CONNECTOR_GCS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
CONNECTOR_GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CONNECTOR_GCS_TEST_BUCKET=your-test-bucket-name

# Azure Blob — TEST_CONTAINER must already exist; the live test can't create one.
CONNECTOR_AZURE_BLOB_ACCOUNT=your_storage_account_name_here
CONNECTOR_AZURE_BLOB_ACCOUNT_KEY=your_storage_account_key_here
CONNECTOR_AZURE_BLOB_TEST_CONTAINER=your-test-container-name

# Stripe — real sk_test_... key; creates test-mode-only, dashboard-isolated objects.
CONNECTOR_STRIPE_SECRET_KEY=your_stripe_test_secret_key_here

# Razorpay — real rzp_test_... key; creates test-mode-only, dashboard-isolated orders.
CONNECTOR_RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
CONNECTOR_RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here

# PayPal — sandbox app credentials; environment is hardcoded to sandbox in the live test.
CONNECTOR_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
CONNECTOR_PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Sentry — a real org auth token; live-tests only read-only endpoints (listProjects/listIssues).
CONNECTOR_SENTRY_TOKEN=your_sentry_auth_token_here
CONNECTOR_SENTRY_ORGANIZATION=your_sentry_org_slug_here

# SendGrid — real key; sendMail live test uses mail_settings.sandbox_mode, no real email sent.
CONNECTOR_SENDGRID_API_KEY=your_sendgrid_api_key_here

# Discord — sendChannelMessage has no delete method; gated behind LIVE_TEST_ALLOW_VISIBLE_EFFECTS.
CONNECTOR_DISCORD_BOT_TOKEN=your_discord_bot_token_here
CONNECTOR_DISCORD_CHANNEL_ID=your_discord_test_channel_id_here

# Telegram — getMe is unconditionally live-safe; sendMessage has no delete method and is
# gated behind LIVE_TEST_ALLOW_VISIBLE_EFFECTS.
CONNECTOR_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
CONNECTOR_TELEGRAM_CHAT_ID=your_telegram_test_chat_id_here

# Slack — read methods are unconditionally live-safe; postMessage self-cleans via
# deleteMessage but is still gated behind LIVE_TEST_ALLOW_VISIBLE_EFFECTS (briefly visible
# to channel members before deletion).
CONNECTOR_SLACK_BOT_TOKEN=your_slack_bot_token_here
CONNECTOR_SLACK_CHANNEL_ID=your_slack_test_channel_id_here

# ntfy — topics are effectively public/guessable; publish is gated behind
# LIVE_TEST_ALLOW_VISIBLE_EFFECTS. No auth token needed for ntfy.sh's default public instance.
CONNECTOR_NTFY_TEST_TOPIC=your-ntfy-test-topic-here

# Twilio — read methods (listCalls/getCall) are unconditionally live-safe; sendMessage/
# createCall are gated behind LIVE_TEST_ALLOW_VISIBLE_EFFECTS regardless of whether you
# configure real or Twilio's documented test-credential "magic" numbers (see
# https://www.twilio.com/docs/iam/test-credentials — +15005550006 sends/calls at zero cost
# under a Twilio *Test* credential pair, a separate SID/token from your live credentials).
CONNECTOR_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
CONNECTOR_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
CONNECTOR_TWILIO_FROM_NUMBER=+15005550006
CONNECTOR_TWILIO_TO_NUMBER=+15005550006

# Gates the handful of live tests above whose vendor call has a real-world-visible
# side effect with no way to undo it. Leave unset for a normal local/CI run.
LIVE_TEST_ALLOW_VISIBLE_EFFECTS=
