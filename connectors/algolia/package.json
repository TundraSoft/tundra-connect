{
  "name": "@tundraconnect/algolia",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed Algolia Search client: search, save, fetch, delete and browse index records, and wait for indexing tasks to finish.",
  "keywords": [
    "algolia",
    "search",
    "search-api",
    "full-text-search",
    "indexing",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
