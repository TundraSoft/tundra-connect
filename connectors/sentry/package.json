{
  "name": "@tundraconnect/sentry",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed Sentry API client: list projects; list, fetch and update issues; read issue events; and create releases.",
  "keywords": [
    "sentry",
    "error-tracking",
    "monitoring",
    "issues",
    "releases",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
