{
  "name": "@tundraconnect/urlhaus",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed URLhaus (abuse.ch) client: look up URLs, hosts and payloads in the malware-URL database, with not-listed results instead of errors and a hard per-call deadline.",
  "keywords": [
    "urlhaus",
    "abuse.ch",
    "malware",
    "malware-urls",
    "threat-intelligence",
    "url-reputation",
    "blocklist",
    "url-safety",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
