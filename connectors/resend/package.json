{
  "name": "@tundraconnect/resend",
  "version": "0.0.0",
  "type": "module",
  "description": "Typed Resend client: send single and batch transactional email with idempotency keys, retrieve delivery status, reschedule or cancel scheduled email, and verify Svix-signed webhooks.",
  "keywords": [
    "resend",
    "email",
    "transactional-email",
    "email-api",
    "send-email",
    "batch-email",
    "scheduled-email",
    "email-delivery",
    "webhooks",
    "svix",
    "idempotency",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
