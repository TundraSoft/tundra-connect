{
  "name": "@tundraconnect/kalshi",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed Kalshi client: public market data, plus RSA-PSS-signed trading — balance, positions, fills and orders; place, amend and cancel orders.",
  "keywords": [
    "kalshi",
    "prediction-markets",
    "trading",
    "market-data",
    "rsa-pss",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/crypt": "npm:@jsr/tundralibs__crypt@^1.4.1",
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
