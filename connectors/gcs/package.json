{
  "name": "@tundraconnect/gcs",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed Google Cloud Storage client with bearer or service-account auth: upload, download, list, inspect and delete objects, including resumable streamed uploads for large files.",
  "keywords": [
    "gcs",
    "google-cloud-storage",
    "google-cloud",
    "object-storage",
    "file-upload",
    "resumable-upload",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/crypt": "npm:@jsr/tundralibs__crypt@^1.4.1",
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
