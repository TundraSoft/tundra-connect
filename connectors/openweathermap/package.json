{
  "name": "@tundraconnect/openweathermap",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed OpenWeatherMap client: current weather and 5-day / 3-hour forecasts by city name or coordinates.",
  "keywords": [
    "openweathermap",
    "weather",
    "weather-api",
    "forecast",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
