{
  "name": "@tundraconnect/google-web-risk",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed Google Web Risk client: check a URL against Google's malware, phishing and unwanted-software lists with the Lookup API's uris:search, under a hard per-call deadline.",
  "keywords": [
    "google",
    "web-risk",
    "google-web-risk",
    "safe-browsing",
    "url-safety",
    "phishing",
    "malware",
    "url-reputation",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
