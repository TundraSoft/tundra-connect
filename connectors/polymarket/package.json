{
  "name": "@tundraconnect/polymarket",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed Polymarket client: Gamma market discovery, CLOB trading with secp256k1/EIP-712 order signing, portfolio positions and value, and gasless split/merge/redeem.",
  "keywords": [
    "polymarket",
    "prediction-markets",
    "trading",
    "clob",
    "eip-712",
    "polygon",
    "web3",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@std/encoding": "npm:@jsr/std__encoding@^1.0.11",
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
