{
  "name": "@tundraconnect/cloudflare-dns",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed Cloudflare DNS client: list, create, update, replace, delete and batch-edit DNS records in a zone, export the zone as BIND, and look up zones by name.",
  "keywords": [
    "cloudflare",
    "cloudflare-dns",
    "dns",
    "dns-records",
    "zones",
    "domain",
    "dns-api",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
