{
  "name": "@tundraconnect/dodo-payments",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed Dodo Payments client: create and verify payments, manage subscriptions and plan changes, sync products, open the customer portal, and verify Standard Webhooks signatures.",
  "keywords": [
    "dodo-payments",
    "payments",
    "subscriptions",
    "products",
    "customer-portal",
    "billing",
    "merchant-of-record",
    "webhooks",
    "standard-webhooks",
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cloudflare-workers",
    "tundraconnect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./schemas": "./schema/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@std/encoding": "npm:@jsr/std__encoding@^1.0.11",
    "@tundralibs/crypt": "npm:@jsr/tundralibs__crypt@^1.4.1",
    "@tundralibs/utils": "npm:@jsr/tundralibs__utils@^1.3.1"
  }
}
